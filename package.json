{
  "name": "om-file-orchestrator",
  "version": "2.1.0",
  "description": "Downloads and manages spatial OM files and GRIB acquisition, with injectable offline ingestion",
  "main": "lib/index.js",
  "bin": {
    "om-orchestrator": "./index.js",
    "om-grib-worker": "lib/worker.js",
    "om-grib-config": "lib/config-cli.js"
  },
  "scripts": {
    "test": "node test/test-scenarios.js",
    "test:permissions": "node test/test-permissions.js",
    "test:priority": "node test/test-priority.js",
    "test:quick": "node test/test-permissions.js",
    "test:paths": "node test/verify-drop-key-path-forms.js",
    "test:inflight": "node test/verify-inflight-dedup.js",
    "start": "node index.js",
    "start:fake": "node index.js --fake",
    "dev": "node index.js --immediate",
    "setup": "chmod +x setup.sh && ./setup.sh",
    "example:simple": "node examples/simple-usage.js",
    "example:fastify": "node examples/fastify-integration.js",
    "example:custom": "node examples/custom-config.js",
    "test:ingestion": "node --test test/ingestion*.test.js test/forecast-history.test.js",
    "test:offline": "npm run test:ingestion && node test/verify-retention-by-step.js && npm run test:paths && npm run test:inflight"
  },
  "author": "Sebastien Etienne <thespotsguru@gmail.com>",
  "license": "ISC",
  "keywords": [
    "weather",
    "meteorology",
    "openmeteo",
    "data-download",
    "orchestrator",
    "automation",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SebSwan/om-file-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/SebSwan/om-file-orchestrator/issues"
  },
  "homepage": "https://github.com/SebSwan/om-file-orchestrator#readme",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "fs-extra": "^11.3.1",
    "lmdb": "^3.4.4",
    "node-cron": "^4.2.1",
    "p-queue": "^8.1.1",
    "winston": "^3.17.0"
  },
  "types": "lib/index.d.ts",
  "peerDependencies": {
    "prom-client": ">=14 <16"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  }
}
